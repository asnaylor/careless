#!/usr/bin/env bash
# Launch distributed DIALS preparation from a Perlmutter Slurm allocation.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: run_prepare_dials_perlmutter \
  --input-dir PATH \
  --prepared-out PATH \
  [careless.prepare_dials options]

The launcher mounts the resolved input directory read-only and the resolved
output parent directory read-write in every container. The output destination
must not already exist.

Required environment:
  IMAGE  Careless container image containing careless.prepare_dials
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

(( $# > 0 )) || {
  usage >&2
  die "pass careless.prepare_dials arguments"
}
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  usage
  exit 0
fi

cli_args=("$@")
input_dir_arg=""
prepared_out_arg=""
readers_per_node=4
max_files=""

for ((index = 0; index < ${#cli_args[@]}; index++)); do
  argument="${cli_args[index]}"
  case "${argument}" in
    --input-dir|--prepared-out|--readers-per-node|--max-files)
      (( index + 1 < ${#cli_args[@]} )) \
        || die "${argument} requires a value"
      value="${cli_args[index + 1]}"
      [[ -n "${value}" ]] || die "${argument} requires a non-empty value"
      case "${argument}" in
        --input-dir)
          [[ -z "${input_dir_arg}" ]] || die "--input-dir was provided more than once"
          input_dir_arg="${value}"
          ;;
        --prepared-out)
          [[ -z "${prepared_out_arg}" ]] || die "--prepared-out was provided more than once"
          prepared_out_arg="${value}"
          ;;
        --readers-per-node)
          readers_per_node="${value}"
          ;;
        --max-files)
          max_files="${value}"
          ;;
      esac
      index=$((index + 1))
      ;;
    --input-dir=*)
      [[ -z "${input_dir_arg}" ]] || die "--input-dir was provided more than once"
      input_dir_arg="${argument#*=}"
      [[ -n "${input_dir_arg}" ]] || die "--input-dir requires a non-empty value"
      ;;
    --prepared-out=*)
      [[ -z "${prepared_out_arg}" ]] || die "--prepared-out was provided more than once"
      prepared_out_arg="${argument#*=}"
      [[ -n "${prepared_out_arg}" ]] || die "--prepared-out requires a non-empty value"
      ;;
    --readers-per-node=*)
      readers_per_node="${argument#*=}"
      ;;
    --max-files=*)
      max_files="${argument#*=}"
      ;;
  esac
done

[[ -n "${input_dir_arg}" ]] || die "--input-dir is required"
[[ -n "${prepared_out_arg}" ]] || die "--prepared-out is required"
[[ -n "${SLURM_JOB_ID:-}" ]] || die "run inside a Slurm allocation"
[[ -n "${SLURM_JOB_NODELIST:-}" ]] || die "SLURM_JOB_NODELIST is not set"
[[ -n "${IMAGE:-}" ]] || die "export IMAGE=<careless-container>"

for command_name in find grep podman-hpc scontrol srun tee timeout; do
  command -v "${command_name}" >/dev/null 2>&1 \
    || die "required command not found: ${command_name}"
done

mapfile -t nodes < <(scontrol show hostnames "${SLURM_JOB_NODELIST}")
(( ${#nodes[@]} >= 1 )) || die "allocation contains no nodes"
head_node="${nodes[0]}"
[[ "${SLURM_JOB_ID}" =~ ^([0-9]+) ]] || die "invalid Slurm job id"
port="$((24000 + BASH_REMATCH[1] % 16000))"
address="${head_node}:${port}"
cpus="${SLURM_CPUS_PER_TASK:-8}"
[[ "${cpus}" =~ ^[1-9][0-9]*$ ]] || die "invalid CPU count: ${cpus}"
[[ "${readers_per_node}" =~ ^[1-9][0-9]*$ ]] \
  || die "--readers-per-node must be positive"
(( readers_per_node < cpus )) \
  || die "--readers-per-node (${readers_per_node}) must be lower than CPUs per task (${cpus}) to reserve one CPU for assembly"
if [[ -n "${max_files}" && ! "${max_files}" =~ ^[1-9][0-9]*$ ]]; then
  die "--max-files must be positive"
fi

workdir="$(pwd -P)"
[[ -d "${input_dir_arg}" ]] || die "input directory does not exist: ${input_dir_arg}"
input_dir="$(cd -- "${input_dir_arg}" && pwd -P)"
[[ -r "${input_dir}" && -x "${input_dir}" ]] \
  || die "input directory is not readable: ${input_dir}"

if [[ "${prepared_out_arg}" == /* ]]; then
  prepared_candidate="${prepared_out_arg}"
else
  prepared_candidate="${workdir}/${prepared_out_arg}"
fi
prepared_name="$(basename -- "${prepared_candidate}")"
prepared_parent_arg="$(dirname -- "${prepared_candidate}")"
[[ "${prepared_name}" != "." && "${prepared_name}" != "/" ]] \
  || die "--prepared-out must name a new directory"
mkdir -p -- "${prepared_parent_arg}"
prepared_parent="$(cd -- "${prepared_parent_arg}" && pwd -P)"
prepared_out="${prepared_parent}/${prepared_name}"
[[ -w "${prepared_parent}" ]] \
  || die "output parent is not writable: ${prepared_parent}"
[[ ! -e "${prepared_out}" && ! -L "${prepared_out}" ]] \
  || die "prepared output already exists: ${prepared_out}"
[[ "${prepared_out}" != "${input_dir}" ]] \
  || die "--prepared-out must differ from --input-dir"

forward_args=()
for ((index = 0; index < ${#cli_args[@]}; index++)); do
  argument="${cli_args[index]}"
  case "${argument}" in
    --input-dir)
      forward_args+=(--input-dir "${input_dir}")
      index=$((index + 1))
      ;;
    --input-dir=*)
      forward_args+=("--input-dir=${input_dir}")
      ;;
    --prepared-out)
      forward_args+=(--prepared-out "${prepared_out}")
      index=$((index + 1))
      ;;
    --prepared-out=*)
      forward_args+=("--prepared-out=${prepared_out}")
      ;;
    *)
      forward_args+=("${argument}")
      ;;
  esac
done

log="${CARELESS_PREPARE_LOG:-${SCRATCH:-/tmp}/careless-prepare-${SLURM_JOB_ID}.log}"
timeout_seconds="${CARELESS_PREPARE_TIMEOUT_SECONDS:-21600}"
[[ "${timeout_seconds}" =~ ^[1-9][0-9]*$ ]] || die "invalid timeout"

srun_args=(
  --nodes="${#nodes[@]}"
  --ntasks="${#nodes[@]}"
  --ntasks-per-node=1
  --cpus-per-task="${cpus}"
)
podman_args=(
  podman-hpc run
  --rm
  --net=host
  --shm-size="${CARELESS_RAY_SHM_SIZE:-80GB}"
)
input_mount_mode=ro
if [[ "${input_dir}" == "${prepared_parent}" ]]; then
  input_mount_mode=rw
  podman_args+=(-v "${input_dir}:${input_dir}:rw")
else
  podman_args+=(
    -v "${input_dir}:${input_dir}:ro"
    -v "${prepared_parent}:${prepared_parent}:rw"
  )
fi
podman_args+=(
  -w /tmp
  --env "RAY_ADDRESS=${address}"
  --env RAY_SYMMETRIC_RUN_CLUSTER_WAIT_TIMEOUT=300
  --env PYTHONUNBUFFERED=1
  --env RAY_NUM_GPUS=0
  --env RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0
  --env "SLURM_JOB_NUM_NODES=${#nodes[@]}"
  --env "SLURM_CPUS_PER_TASK=${cpus}"
  "${IMAGE}"
)
container_command=(
  "${podman_args[@]}"
  bash -lc
  'exec ray symmetric-run \
    --address "$RAY_ADDRESS" \
    --min-nodes "$SLURM_JOB_NUM_NODES" \
    --num-cpus "$SLURM_CPUS_PER_TASK" \
    --num-gpus 0 \
    -- \
    careless.prepare_dials "$@"'
  careless-prepare
  "${forward_args[@]}"
)

mkdir -p -- "$(dirname -- "${log}")"
printf 'IMAGE=%s\nINPUT_MOUNT=%s:%s\nOUTPUT_MOUNT=%s:rw\nARGS=' \
  "${IMAGE}" "${input_dir}" "${input_mount_mode}" "${prepared_parent}" \
  | tee "${log}"
printf '%q ' "${forward_args[@]}" | tee -a "${log}"
printf '\n' | tee -a "${log}"

runner_pid=""
terminate_runner() {
  [[ -n "${runner_pid}" ]] || return 0
  if kill -0 "${runner_pid}" 2>/dev/null; then
    kill -TERM "${runner_pid}" 2>/dev/null || true
  fi
  wait "${runner_pid}" 2>/dev/null || true
  runner_pid=""
}
trap terminate_runner EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

timeout --signal=TERM --kill-after=30s "${timeout_seconds}s" \
  srun "${srun_args[@]}" "${container_command[@]}" \
  > >(tee -a "${log}") 2>&1 &
runner_pid=$!
result_seen=false
while kill -0 "${runner_pid}" 2>/dev/null; do
  if grep -Fq 'CARELESS_PREPARE_RESULT=' "${log}"; then
    result_seen=true
    break
  fi
  sleep 1
done
if [[ "${result_seen}" == true ]]; then
  echo "Preparation result received; stopping the Ray job step." | tee -a "${log}"
  terminate_runner
else
  set +e
  wait "${runner_pid}"
  runner_status=$?
  set -e
  runner_pid=""
  if (( runner_status != 0 )); then
    echo "Ray job step exited with status ${runner_status}." | tee -a "${log}"
  fi
fi

result_line="$(grep -F 'CARELESS_PREPARE_RESULT=' "${log}" | tail -n 1 || true)"
[[ -n "${result_line}" ]] || die "preparation did not emit a result; see ${log}"
[[ "${result_line}" == *'"status": "pass"'* ]] \
  || die "preparation did not pass; see ${log}"

[[ -d "${prepared_out}" ]] \
  || die "prepared output was not persisted on the host: ${prepared_out}"
[[ -s "${prepared_out}/manifest.json" ]] \
  || die "persisted output is missing manifest.json: ${prepared_out}"
[[ -s "${prepared_out}/COMPLETE" ]] \
  || die "persisted output is missing COMPLETE: ${prepared_out}"
shard="$(find "${prepared_out}" -maxdepth 1 -type f \
  -name 'part-*.safetensors' -print -quit)"
[[ -n "${shard}" ]] \
  || die "persisted output contains no SafeTensors shards: ${prepared_out}"

echo "Careless DIALS preparation passed and persisted: ${prepared_out}"
echo "Log: ${log}"
